{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: Debug (module streamlit)",
      "type": "python",
      "request": "launch",
      "console": "integratedTerminal",
      "justMyCode": true,
      "cwd": "${workspaceFolder}",
      "module": "streamlit",
      "args": [
        "run",
        "MainApp.py",
        "--server.port",
        "8501",
        "--server.address",
        "127.0.0.1"
      ],
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
